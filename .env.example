# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Secrets (passwords) come from here / your secret store — never from the UI
# and never hard-coded.

# ---- Data source mode ----
DATA_MODE=synthetic            # synthetic (laptop) | live (client Dev)

# ---- Operational plane: DB2 (JCC / JPA) ----
SRSE_DB2_URL=jdbc:db2://db2:50000/SRSEDB
SRSE_DB2_USER=db2inst1
SRSE_DB2_PASSWORD=change_me

# ---- Analytical plane: PrestoDB 0.297 (JDBC) ----
# Driver: com.facebook.presto:presto-jdbc  (NOT Trino)
SRSE_PRESTO_URL=jdbc:presto://presto:8080/iceberg/srse
SRSE_PRESTO_USER=srse
# SRSE_PRESTO_PASSWORD=            # if the client endpoint requires auth
# SSL — leave SRSE_PRESTO_SSL unset/false for a non-SSL endpoint. Setting the
# trust-store vars while SSL is false has no effect (Java only reads them
# when SSL is actually enabled — see AnalyticalDataSourceConfig).
# SRSE_PRESTO_SSL=true
# SRSE_PRESTO_TRUSTSTORE_PATH=/path/to/truststore.jks
# SRSE_PRESTO_TRUSTSTORE_PASSWORD=

# ---- Auth ----
SRSE_AUTH_MODE=mock            # mock (laptop) | rajsso (client Dev)
# SRSE_RAJSSO_CLIENT_ID=
# SRSE_RAJSSO_CLIENT_SECRET=
# SRSE_JWT_SECRET=

# ---- Guardrails ----
SRSE_COHORT_CAP=1000
SRSE_QUERY_TIMEOUT_SECONDS=30

# ---- Schema/table names ----
# The operational table and most column names resolve per-field through the
# Admin tab's field-mapping screen (DataMode=LIVE) — not env vars — so the
# same image works against any Golden Layer table with zero redeploy. The one
# exception is age_band (breakdown-only dimension, never an officer-selectable
# field, so there's no catalogue entry to hang a mapping off):
SRSE_AGE_BAND_COLUMN=age_band

# ---- Frontend / CORS (set both when deploying to a new host) ----
# NEXT_PUBLIC_API_BASE: baked into the frontend's JS bundle at BUILD time —
#   set to the URL the BROWSER uses to reach the backend (not a Docker
#   hostname like "srse-backend"). Changing it requires a REBUILD, not just
#   a container restart: `docker compose build srse-frontend`.
# SRSE_FRONTEND_ORIGINS: backend CORS allow-list — must match the URL the
#   BROWSER loads the frontend from. Comma-separated for multiple origins.
#   Backend only needs a restart (no rebuild) to pick this up.
NEXT_PUBLIC_API_BASE=http://localhost:8080
SRSE_FRONTEND_ORIGINS=http://localhost:3000
NEXT_PUBLIC_AUTH_MODE=mock
